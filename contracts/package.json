{
  "name": "@telligence/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "src/",
    "script/",
    "lib/",
    "foundry.toml",
    "remappings.txt"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "forge test --no-match-path 'test/fork/**'",
    "test:fork": "forge test --match-path 'test/fork/**'",
    "test:ci": "FOUNDRY_PROFILE=ci forge test --no-match-path 'test/fork/**' --deny notes",
    "build": "forge build --skip '*/test/**' --skip '*/script/**' --deny notes",
    "format": "forge fmt",
    "format:check": "forge fmt --check"
  },
  "dependencies": {
    "@bananapus/721-hook-v6": "1.1.0",
    "@bananapus/buyback-hook-v6": "1.1.0",
    "@bananapus/core-v6": "1.1.0",
    "@bananapus/ownable-v6": "1.0.0",
    "@bananapus/permission-ids-v6": "1.0.0",
    "@bananapus/router-terminal-v6": "1.1.0",
    "@bananapus/suckers-v6": "1.0.2",
    "@croptop/core-v6": "1.0.1",
    "@openzeppelin/contracts": "5.6.1",
    "@uniswap/permit2": "github:Uniswap/permit2#cc56ad0f3439c502c246fc5cfcc3db92bb8b7219",
    "@uniswap/v3-core": "github:Uniswap/v3-core#6562c52e8f75f0c10f9deaf44861847585fc8129",
    "@uniswap/v3-periphery": "github:Uniswap/v3-periphery#b325bb0905d922ae61fcc7df85ee802e8df5e96c",
    "@zksync/contracts": "github:matter-labs/era-contracts#446d391d34bdb48255d5f8fef8a8248925fc98b9"
  },
  "devDependencies": {
    "@bananapus/address-registry-v6": "1.1.0",
    "@uniswap/v4-core": "1.0.2"
  }
}
