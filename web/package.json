{
  "name": "@telligence/web",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "26.5.x",
    "npm": "12.0.x"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "build": "npm run env:check:build && next build --webpack",
    "build:browser": "node scripts/build-browser.mjs",
    "start": "npm run env:check:runtime && next start",
    "start:standalone": "npm run env:check:runtime && node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "format:ratchet": "node scripts/check-format-ratchet.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run wallet-writes:check && vitest run --coverage",
    "test:browser": "playwright test",
    "browser:fixture": "node scripts/browser-fixture-server.mjs",
    "audit:production": "node scripts/audit-production.mjs",
    "dependencies:check": "npm ls --depth=0",
    "protocol:check": "node scripts/check-protocol-deployments.mjs",
    "wallet-writes:check": "node scripts/check-wallet-write-sites.mjs",
    "source:check": "node scripts/check-source-invariants.mjs && node scripts/audit-production.mjs --source-only",
    "dead-code:check": "knip",
    "bundle:check": "node scripts/check-client-bundle.mjs",
    "standalone:check": "node scripts/check-standalone.mjs",
    "standalone:stage": "node scripts/stage-standalone.mjs",
    "deployment:check": "node scripts/check-deployment-config.mjs",
    "env:check:build": "node --env-file-if-exists=.env.local scripts/validate-env.mjs build",
    "env:check:runtime": "node --env-file-if-exists=.env.local scripts/validate-env.mjs runtime",
    "env:test": "node scripts/test-validate-env.mjs",
    "check": "npm run dependencies:check && npm run dead-code:check && npm run env:test && npm run deployment:check && npm run typecheck && npm run lint && npm run format:ratchet && npm run source:check && npm run protocol:check && npm run test:ci && npm run build:browser && npm run standalone:check && npm run bundle:check && npm run test:browser",
    "ts:compile": "tsc",
    "format:write": "prettier --write \"**/*.{js,jsx,mjs,ts,tsx,json,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,ts,tsx,json,css,scss}\""
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "^2.3.2",
    "@coinbase/wallet-sdk": "4.3.7",
    "@getpara/react-component-library": "3.15.0",
    "@getpara/react-sdk-lite": "3.15.0",
    "@getpara/wagmi-v2-connector": "3.15.0",
    "@getpara/web-sdk": "3.15.0",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "5.101.4",
    "@wagmi/core": "3.6.4",
    "@walletconnect/ethereum-provider": "2.23.10",
    "dompurify": "3.4.14",
    "marked": "^18.0.10",
    "next": "16.3.4",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "viem": "2.55.8",
    "wagmi": "3.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/compat": "2.1.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "26.1.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "17.0.2",
    "jsdom": "^29.1.1",
    "knip": "6.29.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5"
  },
  "overrides": {
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    },
    "axios": "1.18.1",
    "brace-expansion@<2": "1.1.16",
    "brace-expansion@>=2 <3": "2.1.2",
    "bn.js@4": "4.12.5",
    "glob@>=10 <11": "10.5.0",
    "minimatch@>=9 <10": "9.0.9",
    "nanoid": "3.3.18",
    "picomatch@<3": "2.3.2",
    "postcss": "$postcss",
    "sharp": "0.35.4",
    "ws": "8.21.1"
  },
  "packageManager": "npm@12.0.1"
}
