# Copy to services/.env locally; never commit secrets. No usable credentials are provided.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://telligence:local-development-only@localhost:5432/telligence
ALLOWED_WEB_ORIGINS=http://localhost:3002
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Generate each independently from at least 32 cryptographically random bytes.
API_KEY_PEPPER=
# Each signer caller has its own credential. The gateway and worker set
# AUTH_SIGNER_SERVICE_SECRET to their own value; the signer receives both.
AUTH_SIGNER_SERVICE_SECRET=
AUTH_SIGNER_GATEWAY_SECRET=
AUTH_SIGNER_WORKER_SECRET=
# Set only on auth-signer, canonical base64 of 32 random bytes. Keep offline backup.
SIGNER_ENCRYPTION_KEY=
# Only during a key rotation: the previous key. Remove it once
# `node auth-signer/rotate-encryption-key.mjs --check` reports zero rotatable rows.
SIGNER_ENCRYPTION_KEY_PREVIOUS=
# Optional ledger anchor "<ISO time>:<count>" printed by
# `node db/restore-check.mjs --print-checkpoint` and stored outside the database.
# A restored ledger with fewer rows refuses new reservations until reconciled.
EXPECTED_LEDGER_CHECKPOINT=
# Per-service PostgreSQL roles created by `node db/roles.mjs` (migration owner only).
TELLIGENCE_GATEWAY_DB_PASSWORD=
TELLIGENCE_SIGNER_DB_PASSWORD=
TELLIGENCE_WORKER_DB_PASSWORD=
AUTH_SIGNER_URL=http://localhost:3001
BASE_RPC_URL=
# Empty = no launches. Must include verified runtime hashes and economic launchPolicy.
TELLIGENCE_MANIFEST_PATH=
# Recommended production mode: approved models and ceilings; free provider metadata refresh cannot raise these limits.
MODEL_POLICY_JSON=
# Alternative explicit observation mode; do not set both. Empty modes = inference disabled. Use reviewed integer micro-USD per million tokens.
# Shape: {"validUntil":"ISO within 24h","models":{"provider-model-id":{"inputMicroUsdPerMillion":INTEGER,"outputMicroUsdPerMillion":INTEGER,"maxOutputTokens":INTEGER,"maxInputBytes":INTEGER,"maxContextTokens":INTEGER}}}
MODEL_PRICES_JSON=
# Worker requires explicit execution opt-in plus a gas-only private key; default is read-only.
KEEPER_PRIVATE_KEY=
KEEPER_EXECUTION_ENABLED=false
